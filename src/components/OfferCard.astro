---
// Shared "identity solution" card: currently used by Legacy Session's
// three-path section. Services.astro has its own near-identical .tier
// markup/CSS predating this component — when Services gets its next
// pass, retrofit it to use this instead of keeping two copies.
interface Props {
	image: string;
	imageAlt: string;
	name: string;
	tagline: string;
	description: string;
	listLabel?: string;
	listItems?: string[];
	footnote?: string;
	href?: string;
}

const { image, imageAlt, name, tagline, description, listLabel, listItems, footnote, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="offer-card" {...(href ? { href } : {})}>
	<div class="offer-image">
		<img src={image} alt={imageAlt} />
	</div>
	<div class="offer-inner">
		<h3 class="offer-name">{name}</h3>
		<p class="offer-tagline">{tagline}</p>
		<p class="offer-desc">{description}</p>
		{listItems && listItems.length > 0 && (
			<>
				{listLabel && <div class="offer-list-label">{listLabel}</div>}
				<ul>
					{listItems.map((item) => <li>{item}</li>)}
				</ul>
			</>
		)}
		{footnote && <p class="offer-footnote">{footnote}</p>}
	</div>
</Tag>

<style>
	.offer-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: all 0.3s ease;
		text-decoration: none;
		color: inherit;
	}

	.offer-image {
		width: 100%;
		flex-shrink: 0;
		overflow: hidden;
		background: var(--surface-raised);
		border-bottom: 1px solid var(--border);
		line-height: 0;
	}
	.offer-image img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.5s ease;
	}
	.offer-card:hover .offer-image img { transform: scale(1.03); }

	.offer-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 0%, var(--accent-warm-dim), transparent 60%);
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.offer-card:hover::before { opacity: 1; }
	.offer-card:hover {
		border-color: color-mix(in srgb, var(--accent-warm) 15%, transparent);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px var(--shadow-color);
	}

	.offer-inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 28px 26px;
	}

	.offer-name {
		font-size: var(--fs-h3);
		font-weight: 700;
		color: var(--text-strong);
		letter-spacing: -0.01em;
		margin-bottom: 4px;
	}

	.offer-tagline {
		font-size: var(--fs-caption);
		font-weight: 500;
		font-style: italic;
		color: var(--accent);
		margin-bottom: 14px;
	}

	.offer-desc {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.65;
		margin-bottom: 18px;
	}

	.offer-list-label {
		font-size: var(--fs-micro);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-dim);
		margin-bottom: 10px;
	}

	.offer-inner ul { list-style: none; padding: 0; margin: 0; }
	.offer-inner li {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text);
		padding-left: 18px;
		position: relative;
		margin-bottom: 8px;
		line-height: 1.5;
	}
	.offer-inner li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 9px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		opacity: 0.5;
	}
	.offer-inner li:last-child { margin-bottom: 0; }

	.offer-footnote {
		font-size: var(--fs-caption);
		font-weight: 500;
		font-style: italic;
		color: var(--text-strong);
		margin-top: 16px;
		padding-top: 16px;
		border-top: 1px solid var(--border);
	}
</style>
