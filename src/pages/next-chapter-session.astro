---
import Layout from '../layouts/Layout.astro';
import OfferCard from '../components/OfferCard.astro';
---

<Layout
	title="Next Chapter Session — IslandTwig Studios"
	description="A complimentary 30-45 minute conversation to uncover your brand's story, goals, and the right path forward for your identity."
	path="/next-chapter-session"
>
	<section class="lw-hero">
		<div class="content">
			<div class="hero-grid">
				<div class="text-col">
					<span class="eyebrow">Next Chapter Session</span>
					<h1>Branding for your <span class="accent-word">next chapter.</span></h1>
					<p class="lead">Whether you're starting something new or your current brand has run its course, I'll help you build an identity you're proud to put everywhere.</p>
					<p class="body">The Next Chapter Session is a complimentary 30&ndash;45 minute conversation to uncover where your brand is today, where you want to go next, and the right path to get there.</p>
					<a href="#start" class="btn btn-primary">Start Your Next Chapter</a>
				</div>
				<div class="hero-image">
					<img src="/images/case-studies/utah-flag/hero-final-submission.jpeg" alt="The final adopted Utah state flag design" />
				</div>
			</div>
		</div>
	</section>

	<!-- PROBLEM -->
	<section class="sec sec-cream">
		<svg class="stripe-mark" style="bottom: 20px; right: 20px; width: 220px; height: 220px; opacity: 0.45;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="10" y="40" width="120" height="14" rx="7" fill="var(--lw-accent)" opacity="0.25"/>
				<rect x="30" y="70" width="150" height="14" rx="7" fill="var(--lw-strong)" opacity="0.08"/>
				<rect x="0" y="100" width="90" height="14" rx="7" fill="var(--lw-accent)" opacity="0.15"/>
			</g>
		</svg>
		<div class="content">
			<div class="text-col">
				<p class="eyebrow">The problem</p>
				<h2 class="big">Your brand should feel like you.</h2>
				<p class="body">Maybe you're starting a business and want to get it right from day one. Maybe that logo you made in Canva got you off the ground, but it doesn't represent where you are anymore. Maybe your team has a great story, but the brand doesn't show it.</p>
				<ul class="pain-list">
					<li>Maybe your logo feels outdated.</li>
					<li>Maybe your merch doesn't create the excitement it should.</li>
					<li>Maybe your website, social graphics, signage, and other materials feel disconnected.</li>
					<li>Maybe you have built something special, but your identity doesn't give people something they're proud to wear and represent.</li>
				</ul>
				<p class="body">You need a brand that looks like you, means something, and works everywhere you need it to. That's where I come in.</p>
			</div>
		</div>
	</section>

	<!-- WHY THIS WORK MATTERS -->
	<section class="sec sec-soft">
		<div class="content">
			<div class="story-split">
				<div class="text-col">
					<p class="eyebrow">Why this work matters</p>
					<h2 class="big">I believe a brand should mean something to the people behind it.</h2>
					<p class="body">Growing up, I saw firsthand how much a team's identity could mean. The colors, logo, and merchandise became part of the community. Families wore them. Players represented them. Fans rallied behind them.</p>
					<p class="body">Later, when I joined a club rugby team, I experienced the opposite. We had passion. We had pride. But our identity never reflected it. The logo and merchandise didn't capture what the team meant to the people involved.</p>
					<p class="body">That experience stayed with me. Because a brand isn't just a graphic. It's the connection between a business or team and the people who support it.</p>
					<p class="body">Today, I help businesses, teams, and organizations create identities that people are proud to represent, wherever they show up.</p>
				</div>
				<div class="story-image">
					<img src="/images/legacy-session/rugby-team.jpg" alt="Nick's club rugby team posing together with their trophy and medals after a tournament win" />
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials section hidden until there's a real client quote to put here.
	     Re-enable by uncommenting once one lands (Utah Flag or Hey Bright would do it).
	<section class="sec sec-cream">
		<div class="content">
			<p class="eyebrow" style="text-align:center;">Don't just take my word for it</p>
			<h2 class="big" style="text-align:center; margin: 0 auto 28px;">What clients are saying.</h2>
			<div class="testimonial-placeholder">
				<p>[Testimonial placeholder. Drop a client quote here once you have one, or delete this section. Even one line from a Utah Flag or Hey Bright contact would do a lot of work in this spot.]</p>
			</div>
		</div>
	</section>
	-->

	<!-- THE LEGACY SESSION, EXPLAINED -->
	<section class="sec sec-dark">
		<svg class="stripe-mark" style="top: 20px; left: 20px; width: 200px; height: 200px; opacity: 0.4;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="20" y="30" width="120" height="14" rx="7" fill="var(--lw-accent)" opacity="0.25"/>
				<rect x="40" y="60" width="140" height="14" rx="7" fill="var(--lw-on-dark)" opacity="0.1"/>
				<rect x="10" y="90" width="90" height="14" rx="7" fill="var(--lw-accent)" opacity="0.15"/>
			</g>
		</svg>
		<div class="content">
			<div class="text-col">
				<p class="eyebrow">How it starts</p>
				<h2 class="big">Start with a conversation. Find the right path forward.</h2>
				<p class="body">The Next Chapter Session is a complimentary 30&ndash;45 minute conversation designed to uncover what your brand needs next. During our conversation, we'll explore:</p>
			</div>
			<div class="explore-grid">
				<div class="explore-card">
					<h3>Your Story</h3>
					<ul>
						<li>Where did your business or team come from?</li>
						<li>What makes you different?</li>
						<li>What makes you, you?</li>
					</ul>
				</div>
				<div class="explore-card">
					<h3>Your Next Chapter</h3>
					<ul>
						<li>Why are you considering a change right now?</li>
						<li>What do you want your identity to accomplish?</li>
						<li>What would success look like?</li>
					</ul>
				</div>
				<div class="explore-card">
					<h3>Your Opportunities</h3>
					<ul>
						<li>Where is your current identity holding you back?</li>
						<li>What could a stronger brand help you achieve?</li>
					</ul>
				</div>
			</div>
			<div class="text-col">
				<p class="body" style="margin-top: 8px;">At the end of the conversation, we'll determine the right next step for your brand. That may be a focused logo project, a complete identity system, or expanding what you already have.</p>
			</div>
		</div>
	</section>

	<!-- THE THREE PATHS FORWARD -->
	<section class="sec sec-cream offer-section">
		<div class="content">
			<p class="eyebrow">Every brand is at a different stage</p>
			<h2 class="big">Find the right identity solution for your brand.</h2>
			<div class="offer-grid">
				<OfferCard
					href="/services"
					image="/images/services/tier-logo.jpg"
					imageAlt="Custom logo mark, an example of Logo Design work"
					name="Logo Design"
					description="A meaningful logo identity built around your story."
				/>
				<OfferCard
					href="/services"
					image="/images/services/tier-system.jpg"
					imageAlt="Full brand identity system"
					name="Brand Identity"
					description="A complete identity system for brands entering a new chapter."
				/>
				<OfferCard
					href="/services"
					image="/images/services/tier-identity.jpg"
					imageAlt="Brand identity applied across merchandise and supporting materials"
					name="Elevate the Identity"
					description="Bring your identity into merchandise, social graphics, and beyond."
				/>
			</div>
		</div>
	</section>

	<!-- IMAGINE WHAT'S POSSIBLE -->
	<section class="sec sec-dark">
		<div class="content">
			<div class="text-col center">
				<p class="eyebrow">Made to be seen</p>
				<h2 class="big">More than a logo.</h2>
				<div class="imagine-lines">
					<p>Your brand might show up on a work truck.</p>
					<p>A billboard.</p>
					<p>A business card.</p>
					<p>A hat.</p>
					<p>A website.</p>
					<p>A social post.</p>
					<p>The medium changes. The identity shouldn't.</p>
					<p>Because when an identity truly represents a brand, it becomes part of the people who support it.</p>
					<p>That's what we're building.</p>
					<p>Not just a logo.</p>
					<p class="imagine-close">An identity people are proud to represent.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- PROCESS -->
	<section class="sec sec-soft">
		<div class="content">
			<div class="text-col">
				<p class="eyebrow">The Next Chapter Method</p>
				<h2 class="big">A process built around meaning.</h2>
				<p class="body">Great identities aren't created by jumping straight into design. They're built through understanding, strategy, and intentional decisions.</p>
			</div>
			<div class="phase-row">
				<div class="phase-card"><span class="phase-num">01</span><h3>Start with the Story</h3><p>We talk about where you've been, where you're going, and what makes you different.</p></div>
				<div class="phase-card"><span class="phase-num">02</span><h3>Build the Identity</h3><p>I turn those ideas into a visual identity that looks like you and means something.</p></div>
				<div class="phase-card"><span class="phase-num">03</span><h3>Put It Everywhere</h3><p>Your new brand shouldn't live in a folder on your computer. We make sure it works wherever people see it.</p></div>
			</div>
		</div>
	</section>

	<!-- WHO YOU'LL WORK WITH -->
	<section class="sec sec-dark">
		<div class="content">
			<div class="nick-split">
				<div class="text-col">
					<p class="eyebrow">Who you'll work with</p>
					<h2 class="big">I'm Nick.</h2>
					<p class="body">I design brand identities for businesses and teams entering a new chapter. One studio, one designer, working directly with you start to finish. No account managers, no handoffs.</p>
					<p class="body">My approach is simple: research before design, built for the real world, made to last. I don't design logos from a template. I build identities that people are proud to represent, wherever they show up.</p>
					<a href="/about" class="btn btn-primary" style="margin-top: 8px;">More about me</a>
				</div>
				<div class="nick-portrait">
					<img src="/images/ProfilePic.JPEG" alt="Nick Holmquist" />
				</div>
			</div>
		</div>
	</section>

	<!-- IS THIS A FIT -->
	<section class="sec sec-cream">
		<div class="content">
			<p class="eyebrow">Real talk</p>
			<h2 class="big">Is the Next Chapter Session right for you?</h2>
			<p class="body">This conversation is designed for business owners, founders, and decision makers at teams and organizations who want to build something meaningful.</p>
			<div class="fit-grid">
				<div class="fit-col yes">
					<h3>It's a fit if you</h3>
					<ul class="fit-list">
						<li>Are entering a new chapter and want an identity that reflects where you're going</li>
						<li>Want more than a generic logo or template</li>
						<li>Believe your story is worth representing</li>
						<li>Want to be involved in uncovering what makes you unique</li>
						<li>Are looking for an identity built to last</li>
					</ul>
				</div>
				<div class="fit-col no">
					<h3>It's not a fit if you</h3>
					<ul class="fit-list">
						<li>Want to skip discovery and jump straight into concepts</li>
						<li>Are only looking for something copied from a trend</li>
						<li>See branding as just decoration</li>
						<li>Aren't ready to invest time into building something meaningful</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="sec sec-soft">
		<div class="content">
			<div class="text-col">
				<p class="eyebrow">Frequently asked questions</p>
				<h2 class="big">Questions answered.</h2>
				<div class="faq-item">
					<h3>Is the Next Chapter Session really free?</h3>
					<p>Yes. The Next Chapter Session is a complimentary 30&ndash;45 minute conversation to understand your brand, goals, and opportunities. There is no obligation to move forward. The purpose is to find clarity and determine the right next step.</p>
				</div>
				<div class="faq-item">
					<h3>Do you only work with existing businesses?</h3>
					<p>No. This approach works for both established brands looking to refresh their identity and new businesses looking to create a strong foundation. Every brand has a story worth building from.</p>
				</div>
				<div class="faq-item">
					<h3>What if we don't know exactly what we need?</h3>
					<p>That's exactly what the Next Chapter Session is for. Many brands know they want something different but aren't sure what the right solution looks like yet. We'll figure that out together.</p>
				</div>
				<div class="faq-item">
					<h3>How long does the process take?</h3>
					<p>Timelines vary depending on the project scope, brand size, and feedback process. Most complete identity projects take approximately 4&ndash;6 weeks.</p>
				</div>
				<div class="faq-item">
					<h3>Do you only create logos?</h3>
					<p>No. A logo can be the beginning of an identity, but it is only one piece. Depending on your needs, we can create a custom Logo Design, develop a complete Brand Identity system, or expand your identity through Elevate the Identity.</p>
				</div>
				<div class="faq-item">
					<h3>What happens after the Next Chapter Session?</h3>
					<p>After our conversation, I'll review what we discussed and recommend the best path forward. If we're a good fit, I'll prepare a custom proposal outlining the scope, timeline, and investment. From there, we can begin building your next chapter.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CLOSING CTA -->
	<section class="sec sec-dark closing-band">
		<svg class="stripe-mark" style="bottom: 20px; left: 20px; width: 220px; height: 220px; opacity: 0.45;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="10" y="40" width="120" height="14" rx="7" fill="var(--lw-accent)" opacity="0.25"/>
				<rect x="30" y="70" width="150" height="14" rx="7" fill="var(--lw-on-dark)" opacity="0.08"/>
				<rect x="0" y="100" width="90" height="14" rx="7" fill="var(--lw-accent)" opacity="0.15"/>
			</g>
		</svg>
		<div class="content">
			<div class="text-col center">
				<h2 class="big">Ready for your next chapter?</h2>
				<p class="body">You don't need to have everything figured out. You just need to know you're ready for something better. Let's create the identity that carries you forward.</p>
				<a href="#start" class="btn btn-primary">Start Your Next Chapter</a>
			</div>
		</div>
	</section>

	<section class="lw-start" id="start">
		<div class="content">
			<h2>Start Your Next Chapter</h2>
			<p class="start-sub">Every great identity starts with understanding. Fill out the form below and tell me a little about your brand. This helps me prepare for our conversation and make your Next Chapter Session as valuable as possible.</p>

			<form class="intake-card" id="intake-form" action="https://formspree.io/f/mgojdjre" method="POST">

				<div class="form-section">
					<h3 class="form-section-title">About Your Brand</h3>

					<div class="field">
						<label for="name">Your Name</label>
						<input type="text" id="name" name="name" required />
					</div>
					<div class="field">
						<label for="team">Business / Brand Name</label>
						<input type="text" id="team" name="team" required />
					</div>
					<div class="field">
						<label for="email">Email Address</label>
						<input type="email" id="email" name="email" required />
					</div>
					<div class="field">
						<label for="website">Website or Social Links <span class="optional">(optional)</span></label>
						<input type="text" id="website" name="website" />
					</div>
					<div class="field">
						<label>What type of brand are you?</label>
						<div class="radio-group">
							<label class="radio-option"><input type="radio" name="org_type" value="Business" required /> Business</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Team or Organization" /> Team or Organization</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Nonprofit" /> Nonprofit</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Personal Brand" /> Personal Brand</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Other" /> Other</label>
						</div>
					</div>
				</div>

				<hr class="form-divider" />

				<div class="form-section">
					<h3 class="form-section-title">Your Brand's Identity</h3>

					<div class="field">
						<label>What best describes where you are today?</label>
						<div class="radio-group stacked">
							<label class="radio-option"><input type="radio" name="stage" value="Creating a new identity from the ground up" required /> We are creating a new identity from the ground up</label>
							<label class="radio-option"><input type="radio" name="stage" value="Refreshing an existing identity" /> We have an existing identity that needs a refresh</label>
							<label class="radio-option"><input type="radio" name="stage" value="Expanding our current brand presence" /> We want to expand and improve our current brand presence</label>
						</div>
					</div>
					<div class="field">
						<label for="why_now">What's prompting you to look at this now?</label>
						<textarea id="why_now" name="why_now"></textarea>
					</div>
				</div>

				<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

				<button type="submit" class="btn btn-primary">
					Let's Get Started
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</button>
				<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
			</form>
		</div>
	</section>

	<script>
		(function () {
			const form = document.getElementById('intake-form') as HTMLFormElement | null;
			if (!form) return;
			const status = document.getElementById('form-status');
			const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
			const originalBtnHTML = btn.innerHTML;
			if (!status) return;

			form.addEventListener('submit', function (e) {
				e.preventDefault();
				btn.innerHTML = 'Sending...';
				btn.disabled = true;
				btn.style.opacity = '0.7';
				status.className = 'form-status';

				fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				})
					.then(function (response) {
						if (response.ok) {
							form.reset();
							status.className = 'form-status success show';
							status.textContent = "Thanks, your message is on its way. I'll get back to you within a day.";
							btn.innerHTML = originalBtnHTML;
							btn.disabled = false;
							btn.style.opacity = '1';
						} else {
							response.json().then(function (d) {
								let msg = 'Something went wrong. Please email hello@islandtwigstudios.com directly.';
								if (d && d.errors && d.errors.length) {
									msg = d.errors.map((er: { message: string }) => er.message).join(', ');
								}
								status.className = 'form-status error show';
								status.textContent = msg;
								btn.innerHTML = originalBtnHTML;
								btn.disabled = false;
								btn.style.opacity = '1';
							});
						}
					})
					.catch(function () {
						status.className = 'form-status error show';
						status.textContent = 'Something went wrong. Please email hello@islandtwigstudios.com directly.';
						btn.innerHTML = originalBtnHTML;
						btn.disabled = false;
						btn.style.opacity = '1';
					});
			});
		})();
	</script>
</Layout>

<style>
	/* Page-scoped aliases, kept on :global(:root) rather than plain
	   :root: Astro scopes styles per-component, and <html> is
	   rendered by Layout.astro, not this page, so an unscoped-looking
	   :root rule here would silently never match. --lw-strong/--lw-dim
	   are NOT aliased to --text-strong/--text-dim: those are global
	   light-on-dark tokens site-wide, but these are used exclusively
	   for dark text on this page's light surfaces (cream/soft
	   sections, white cards), so they need a fixed dark value
	   regardless of the dark-canvas globals. */
	:global(:root) {
		--lw-bg: var(--bg, #181a19);
		--lw-cream: var(--surface-cream, #f4f1e9);
		--lw-soft: var(--surface-soft, #e8e2d4);
		--lw-accent: var(--accent, #ab8a1f);
		--lw-accent-hover: var(--accent-hover, #8f7219);
		--lw-accent-cool: var(--accent-cool, #2d6b45);
		--lw-accent-bright: var(--accent-bright, #c9a227);
		--lw-on-dark: var(--text-on-dark, #f4f1e9);
		--lw-on-dark-dim: var(--text-on-dark-dim, rgba(244, 241, 233, 0.72));
		--lw-strong: #1a1c1a;
		--lw-dim: #5a5f5a;
		--lw-border-light: var(--border-on-light, #c9c3b4);
		--lw-radius: var(--radius, 12px);
		--lw-radius-sm: var(--radius-sm, 8px);
	}

	.content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px; }

	.text-col { max-width: 720px; }
	.text-col.center { max-width: 640px; margin: 0 auto; text-align: center; }
	.text-col.center .btn { margin-top: 4px; }

	/* The intake form reads better as a centered column than
	   stretched to the page's full width, matching the same
	   narrower-and-centered treatment used on services.html. */
	.lw-start .content { max-width: 860px; }

	/* .eyebrow is defined in global.css (shared pill, every page). */

	.btn {
		display: inline-flex; align-items: center; justify-content: center; gap: 8px;
		padding: 15px 30px; border-radius: 100px;
		font-size: var(--fs-small); font-weight: 700; text-decoration: none;
		transition: all 0.25s ease; cursor: pointer; border: none;
	}
	/* Uses the shared --btn-primary-text token (global.css), not a
	   hardcoded color, so this button always matches every other
	   primary button site-wide as the accent color changes. Was
	   hardcoded to #000 from the old gold-accent era — unreadable
	   now that the accent is a dark purple. */
	.btn-primary { background: var(--lw-accent); color: var(--btn-primary-text, #fff); }
	.btn-primary:hover { background: var(--lw-accent-hover); transform: translateY(-1px); box-shadow: 0 10px 24px var(--shadow-color); }

	.sec { padding: 72px 0; position: relative; overflow: hidden; }
	.sec-dark { background: var(--lw-bg); color: var(--lw-on-dark); }
	.sec-cream { background: var(--lw-cream); color: var(--lw-strong); }
	.sec-soft { background: var(--lw-soft); color: var(--lw-strong); }

	h2.big {
		font-size: var(--fs-h2); font-weight: 700;
		letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 18px;
	}
	.sec p.body { font-size: var(--fs-body-lg); line-height: 1.7; margin-bottom: 16px; }
	.sec-dark p.body { color: var(--lw-on-dark-dim); }
	.sec-cream p.body, .sec-soft p.body { color: var(--lw-dim); }
	.sec p.body:last-child { margin-bottom: 0; }

	.lw-hero { background: var(--lw-bg); padding: 52px 0 80px; position: relative; overflow: hidden; }

	/* overflow: visible since the rotated rects inside can extend a
	   few units past the 200x200 viewBox on some corners — SVGs clip
	   to their viewBox by default, which was cutting a sliver off a
	   rounded end. */
	.stripe-mark { position: absolute; pointer-events: none; z-index: 0; overflow: visible; }

