---
import Layout from '../layouts/Layout.astro';
import OfferCard from '../components/OfferCard.astro';
---

<Layout
	title="Services — IslandTwig Studios"
	description="Custom Logo Design, Branding & Rebranding for Businesses and Teams."
	path="/services"
>
	<div class="content">
		<header class="header">
			<div class="text-col">
				<p class="eyebrow">Services</p>
				<h1 class="a2">From a logo to an identity.</h1>
				<p class="a2">I don't just make something that looks good on a screen. I build brands that work in the real world: on trucks, hats, shirts, websites, signs, social media, and everywhere else your brand shows up.</p>
				<div class="availability a3">Available for new projects</div>
			</div>
		</header>
	</div>

	<section class="services-band-light">
	<div class="content">

		<!-- MAIN PACKAGE: BRAND IDENTITY -->
		<div class="signature-grid">
			<div class="signature-text">
				<p class="eyebrow">Main Package</p>
				<h2>Brand Identity</h2>
				<p class="signature-tagline">From overlooked to unforgettable.</p>
				<p class="signature-desc">The complete visual system that gives your brand consistency, personality, and something to stand behind. Whether you're building a new identity from scratch or replacing one that's run its course, this is where a logo becomes a full identity: color, type, and a system built to work everywhere your brand shows up.</p>
				<a href="/next-chapter-session" class="btn-signature">Start Your Next Chapter</a>
			</div>
			<div class="signature-image">
				<img src="/images/services/tier-system.jpg" alt="Full brand identity system, an example of Brand Identity work" />
			</div>
		</div>

		<!-- OTHER WAYS TO WORK TOGETHER -->
		<p class="eyebrow a4">Other Ways to Work Together</p>
		<div class="offer-grid">
			<OfferCard
				image="/images/services/tier-logo.jpg"
				imageAlt="Custom logo mark, an example of Logo Design work"
				name="Logo Design"
				description="A custom logo built around who you are, not a template you found online."
			/>
			<OfferCard
				image="/images/services/tier-identity.jpg"
				imageAlt="Brand identity applied across merchandise and supporting materials, an example of Elevate the Identity work"
				name="Elevate the Identity"
				description="Turn your brand into something people actually want to wear, use, and show off, from merch and swag to the social graphics and supporting materials that carry it everywhere."
			/>
		</div>

		<!-- CUSTOM TIER -->
		<a href="#start" class="custom-tier a7">
			<div class="custom-tier-inner">
				<div>
					<h3>Not sure what you need?</h3>
					<p>Tell me about your brand and I'll help you figure out the right starting point.</p>
				</div>
				<span class="arrow-link">
					Tell me about it
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</span>
			</div>
		</a>

	</div>
	</section>

	<section class="services-band-dark">
	<div class="content">

		<!-- PROCESS -->
		<section class="process-section a8">
			<h2 class="eyebrow">How it works</h2>
			<div class="process-grid">
				<div class="process-step">
					<span class="step-num">01</span>
					<h4>Inquiry</h4>
					<p>Send the form below or email me. I'll respond within a day with questions and a rough timeline.</p>
				</div>
				<div class="process-step">
					<span class="step-num">02</span>
					<h4>Kickoff</h4>
					<p>50% deposit, a short brief, and we start. You'll get a clear schedule for concepts and revisions.</p>
				</div>
				<div class="process-step">
					<span class="step-num">03</span>
					<h4>Concepts &amp; Revisions</h4>
					<p>Concepts arrive together. We refine the direction you like best through the included revision rounds.</p>
				</div>
				<div class="process-step">
					<span class="step-num">04</span>
					<h4>Delivery</h4>
					<p>Final 50% on delivery. You get all source files, exports, and any guide documents in one package.</p>
				</div>
			</div>
		</section>

	</div>
	</section>

	<section class="services-band-light">
	<div class="content">

		<!-- INTAKE FORM -->
		<section class="intake-section a8" id="start">
			<h2>Ready to start your next chapter?</h2>
			<p class="lead">Tell me what you're working on. Anything you can share helps me get back to you with something useful instead of a generic reply.</p>

			<form class="intake-card" id="intake-form" action="https://formspree.io/f/mgojdjre" method="POST">

				<div class="form-section">
					<h3 class="form-section-title">About Your Brand</h3>

					<div class="field">
						<label for="name">Your Name</label>
						<input type="text" id="name" name="name" required />
					</div>
					<div class="field">
						<label for="team">Business / Brand Name</label>
						<input type="text" id="team" name="team" required />
					</div>
					<div class="field">
						<label for="email">Email Address</label>
						<input type="email" id="email" name="email" required />
					</div>
					<div class="field">
						<label for="website">Website or Social Links <span class="optional">(optional)</span></label>
						<input type="text" id="website" name="website" />
					</div>
					<div class="field">
						<label>What type of brand are you?</label>
						<div class="radio-group">
							<label class="radio-option"><input type="radio" name="org_type" value="Business" required /> Business</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Team or Organization" /> Team or Organization</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Nonprofit" /> Nonprofit</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Personal Brand" /> Personal Brand</label>
							<label class="radio-option"><input type="radio" name="org_type" value="Other" /> Other</label>
						</div>
					</div>
				</div>

				<hr class="form-divider" />

				<div class="form-section">
					<h3 class="form-section-title">Your Brand's Identity</h3>

					<div class="field">
						<label>What best describes where you are today?</label>
						<div class="radio-group stacked">
							<label class="radio-option"><input type="radio" name="stage" value="Creating a new identity from the ground up" required /> We are creating a new identity from the ground up</label>
							<label class="radio-option"><input type="radio" name="stage" value="Refreshing an existing identity" /> We have an existing identity that needs a refresh</label>
							<label class="radio-option"><input type="radio" name="stage" value="Expanding our current brand presence" /> We want to expand and improve our current brand presence</label>
						</div>
					</div>
					<div class="field">
						<label for="why_now">What's prompting you to look at this now?</label>
						<textarea id="why_now" name="why_now"></textarea>
					</div>
				</div>

				<!-- Honeypot: hidden from humans, catches bots -->
				<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

				<div class="submit-row">
					<button type="submit" class="submit-btn">
						Let's Get Started
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</button>
					<p class="submit-note">Or just email <a href="mailto:hello@islandtwigstudios.com">hello@islandtwigstudios.com</a> directly.</p>
				</div>

				<div id="form-status" class="form-status" role="status" aria-live="polite"></div>

			</form>
		</section>
	</div>
	</section>

	<script>
		(function () {
			const form = document.getElementById('intake-form') as HTMLFormElement | null;
			const status = document.getElementById('form-status');
			if (!form || !status) return;

			form.addEventListener('submit', function (e) {
				e.preventDefault();
				const btn = form.querySelector('.submit-btn') as HTMLButtonElement;
				const originalBtnHTML = btn.innerHTML;
				btn.disabled = true;
				btn.style.opacity = '0.6';
				btn.textContent = 'Sending...';

				const data = new FormData(form);
				fetch(form.action, {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' },
				})
					.then(function (response) {
						if (response.ok) {
							form.reset();
							status.className = 'form-status success show';
							status.textContent = "Thanks, your message is on its way. I'll get back to you within a day.";
							btn.innerHTML = originalBtnHTML;
							btn.disabled = false;
							btn.style.opacity = '1';
						} else {
							response.json().then(function (d) {
								let msg = 'Something went wrong. Please email hello@islandtwigstudios.com directly.';
								if (d && d.errors && d.errors.length) {
									msg = d.errors.map((er: { message: string }) => er.message).join(', ');
								}
								status.className = 'form-status error show';
								status.textContent = msg;
								btn.innerHTML = originalBtnHTML;
								btn.disabled = false;
								btn.style.opacity = '1';
							});
						}
					})
					.catch(function () {
						status.className = 'form-status error show';
						status.textContent = 'Something went wrong. Please email hello@islandtwigstudios.com directly.';
						btn.innerHTML = originalBtnHTML;
						btn.disabled = false;
						btn.style.opacity = '1';
					});
			});
		})();
	</script>
</Layout>

<style>
	.content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 48px;
	}

	/* ═══ HEADER ═══ */

	.header {
		margin-bottom: 48px;
		padding-top: 56px;
	}

	/* Full-bleed bands, matching the homepage's banding. Scoped
	   custom-property overrides on the light bands mean every
	   existing rule below (already written against these tokens)
	   resolves to light-band-appropriate colors without its own
	   edit. */
	.services-band-light {
		background: var(--surface-cream);
		padding: 56px 0 64px;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}

	.services-band-dark { padding: 64px 0; }

	.services-band-soft {
		background: var(--surface-soft);
		padding: 64px 0;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}


	/* .eyebrow is defined in global.css (shared pill, every page). */

	.header h1 {
		font-size: var(--fs-h1);
		font-weight: 800;
		color: var(--text-strong);
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin-bottom: 18px;
	}

	.header p:not(.eyebrow) {
		font-size: var(--fs-body);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.7;
	}

	/* Uses --accent-bright, not --accent — sits directly on the dark
	   ink header, and the base purple is too dark to read there. */
	.availability {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 18px;
		font-size: var(--fs-caption);
		font-weight: 500;
		color: var(--accent-bright);
		letter-spacing: 0.02em;
	}

	.availability::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-bright);
		box-shadow: 0 0 8px color-mix(in srgb, var(--accent-bright) 60%, transparent);
	}

	/* ═══ CUSTOM TIER ═══ */

	.custom-tier {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 24px 28px;
		margin-bottom: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		position: relative;
		overflow: hidden;
		transition: all 0.3s ease;
		color: inherit;
		text-decoration: none;
	}

	.custom-tier::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 90% 50%, var(--accent-warm-dim), transparent 60%);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.custom-tier:hover::before { opacity: 1; }
	.custom-tier:hover { border-color: color-mix(in srgb, var(--accent-warm) 15%, transparent); }

	.custom-tier-inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: 100%;
	}

	.custom-tier h3 {
		font-size: var(--fs-h4);
		font-weight: 700;
		color: var(--text-strong);
		margin-bottom: 4px;
		letter-spacing: -0.01em;
	}

	.custom-tier p {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.55;
	}

	.arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--fs-small);
		font-weight: 500;
		text-decoration: none;
		transition: gap 0.25s ease, color 0.25s ease;
		color: var(--accent-warm);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.arrow-link svg { width: 13px; height: 13px; }
	.arrow-link:hover { gap: 10px; color: var(--text-strong); }

	/* ═══ MAIN PACKAGE (signature offer) ═══
	   Brand Identity is the flagship service and should visually
	   dominate the page: a larger heading scale, a two-column
	   hero-style layout, and its own CTA, distinct from the three
	   smaller supporting-service cards below it. */

	.signature-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 48px;
		align-items: center;
		margin-bottom: 56px;
	}

	.signature-text h2 {
		font-size: var(--fs-h1);
		font-weight: 800;
		color: var(--text-strong);
		letter-spacing: -0.02em;
		line-height: 1.1;
		margin-bottom: 10px;
	}

	.signature-tagline {
		font-size: var(--fs-lead);
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 16px;
	}

	.signature-desc {
		font-size: var(--fs-body-lg);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.7;
		margin-bottom: 28px;
		max-width: 520px;
	}

	.btn-signature {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 14px 26px;
		border-radius: 100px;
		background: var(--accent);
		color: var(--btn-primary-text);
		font-size: var(--fs-small);
		font-weight: 700;
		text-decoration: none;
		transition: all 0.25s ease;
	}
	.btn-signature:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.2); }

	.signature-image {
		border-radius: var(--radius);
		border: 1px solid var(--border);
		overflow: hidden;
		background: var(--surface-raised);
		aspect-ratio: 4 / 3;
	}
	.signature-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

	/* ═══ SERVICE CATEGORY GRID ═══ */

	.offer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 20px;
		margin-bottom: 40px;
	}

	/* ═══ PROCESS ═══
	   Matches the homepage's process-band card treatment: cards
	   are always a lighter surface than their band, with a
	   Fira Code accent number, regardless of whether the band
	   itself is light or dark (how it works). */

	.process-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.process-step {
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 24px 22px;
	}

	/* Dark-band process cards (How it Works) become cream, same
	   as the homepage. Needs its own dark-on-light text scope:
	   .services-band-dark doesn't otherwise redeclare
	   --text-strong/--text-dim, since its own text is correctly
	   light-on-dark; only the card sitting inside it needs to flip. */
	.services-band-dark .process-step {
		background: var(--surface-cream);
		border-color: var(--border-on-light);
		--text-strong: #1a1c1a;
		--text-dim: #5a5f5a;
	}

	.process-step h4 {
		font-size: var(--fs-h4);
		font-weight: 700;
		color: var(--text-strong);
		margin-bottom: 10px;
	}

	.process-step .step-num {
		display: block;
		font-family: 'Fira Code', monospace;
		font-size: 26px;
		font-weight: 400;
		color: var(--accent-cool);
		margin-bottom: 16px;
	}

	.process-step p {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.6;
	}

	/* ═══ INTAKE FORM ═══
	   .intake-card, .field, .form-status, etc. are defined in
	   global.css now — shared with the Next Chapter Session's intake form. */

	.intake-section h2 {
		font-size: var(--fs-h2);
		font-weight: 800;
		color: var(--text-strong);
		letter-spacing: -0.01em;
		margin-bottom: 8px;
	}

	.intake-section .lead {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.65;
		margin-bottom: 28px;
		max-width: 580px;
	}

	.intake-section {
		max-width: 860px;
		margin: 0 auto;
		scroll-margin-top: 88px;
	}

	.submit-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		margin-top: 24px;
		flex-wrap: wrap;
	}

	.submit-btn {
		background: var(--accent-warm);
		color: var(--btn-primary-text);
		border: none;
		padding: 13px 26px;
		border-radius: 100px;
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: var(--fs-small);
		font-weight: 700;
		letter-spacing: 0.02em;
		cursor: pointer;
		transition: all 0.25s ease;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.submit-btn:hover {
		background: var(--bg);
		color: var(--text-on-dark);
		transform: translateY(-1px);
		box-shadow: 0 6px 18px color-mix(in srgb, var(--accent-warm) 30%, transparent);
	}

	.submit-btn svg { width: 14px; height: 14px; }

	.submit-note {
		font-size: var(--fs-caption);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.5;
	}

	.submit-note a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
	.submit-note a:hover { color: var(--text-strong); }

	/* ═══ ANIMATIONS ═══
	   fadeUp keyframe itself is shared, defined once in Layout.astro. */
	.a1 { opacity:0; animation: fadeUp .6s ease .15s forwards; }
	.a2 { opacity:0; animation: fadeUp .6s ease .25s forwards; }
	.a3 { opacity:0; animation: fadeUp .6s ease .35s forwards; }
	.a4 { opacity:0; animation: fadeUp .6s ease .45s forwards; }
	.a5 { opacity:0; animation: fadeUp .6s ease .55s forwards; }
	.a6 { opacity:0; animation: fadeUp .6s ease .65s forwards; }
	.a7 { opacity:0; animation: fadeUp .6s ease .75s forwards; }
	.a8 { opacity:0; animation: fadeUp .6s ease .85s forwards; }

	@media (max-width: 900px) {
		.process-grid { grid-template-columns: repeat(2, 1fr); }
		.custom-tier-inner { flex-direction: column; align-items: flex-start; }
		.signature-grid { grid-template-columns: 1fr; }
		.signature-image { order: -1; aspect-ratio: 16 / 9; }
	}

	@media (max-width: 768px) {
		.content { padding: 0 24px; }
		.header { padding-top: 40px; }
		.services-band-light { padding: 40px 0 48px; }
		.services-band-dark, .services-band-soft { padding: 48px 0; }
	}

	@media (max-width: 480px) {
		.content { padding: 0 20px; }
		.header { padding-top: 32px; }
		.process-grid { grid-template-columns: 1fr; }
		.intake-card { padding: 22px; }
	}
</style>
