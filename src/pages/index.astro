---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Layout
	title="IslandTwig Studios"
	description="Custom logo design, branding, and rebranding for businesses and teams. When your brand no longer matches where you're going, it's time for a glow-up."
	path="/"
>
	<Fragment slot="head">
		<meta name="apple-itunes-app" content="app-id=6753832202" />
	</Fragment>

	<!-- HERO -->
	<Band variant="dark" class="hero-section">
		<div class="hero-grid">
			<div class="hero">
				<Eyebrow class="a1">Welcome Home</Eyebrow>
				<h1 class="a2">Branding for your <span class="accent-word">next chapter.</span></h1>
				<p class="hero-subhead a3">Whether you're starting something new or your current brand has run its course, I'll help you build an identity you're proud to put everywhere.</p>
				<p class="hero-tagline a3">Logos and brands for businesses and teams. Specializing in sports.</p>
				<div class="hero-actions a4">
					<Button href="/next-chapter-session">Start Your Next Chapter</Button>
					<div class="hero-actions-secondary">
						<Button href="/design" variant="secondary">See Brand Work</Button>
						<Button href="/sports" variant="secondary">See Sports Work</Button>
					</div>
				</div>
			</div>
			<div class="hero-image-block a3">
				<a href="/design#bounce-messenger" class="hero-image">
					<img src="/images/gallery/bouncebento.png" alt="Bounce Messenger brand board: logo mark, color palette, app icon, pattern, and merch applications across a hat and hoodie" />
				</a>
				<p class="hero-image-caption">Bounce Messenger &middot; Brand Identity</p>
			</div>
		</div>
	</Band>

	<!-- PROBLEM -->
	<Band variant="cream" class="problem-band">
		<svg slot="decoration" class="stripe-mark" style="bottom: 20px; right: 20px; width: 220px; height: 220px; opacity: 0.45;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="10" y="40" width="120" height="14" rx="7" fill="var(--accent)" opacity="0.25"/>
				<rect x="30" y="70" width="150" height="14" rx="7" fill="var(--band-text-strong)" opacity="0.08"/>
				<rect x="0" y="100" width="90" height="14" rx="7" fill="var(--accent)" opacity="0.15"/>
			</g>
		</svg>
		<Eyebrow>Where You're At</Eyebrow>
		<p class="problem-line">Your brand should feel like you.</p>
		<div class="problem-body">
			<p>Maybe you're starting a business and want to get it right from day one.</p>
			<p>Maybe that logo you made in Canva got you off the ground, but it doesn't represent where you are anymore.</p>
			<p>Maybe your team has a great story, but the brand doesn't show it.</p>
			<p>Whatever got you here, you're ready for something better.</p>
			<p class="problem-sub">You need a brand that looks like you, means something, and works everywhere you need it to. That's where I come in.</p>
		</div>
	</Band>

	<!-- SERVICES TEASER -->
	<Band variant="dark" class="services-teaser-band">
		<Eyebrow>From a Logo to an Identity</Eyebrow>
		<h2>I don't just make something that looks good on a screen.</h2>
		<p class="services-teaser-lead">I build brands that work in the real world. On trucks, hats, shirts, websites, signs, social media, and everywhere else your brand shows up.</p>
		<div class="services-teaser-grid">
			<div class="services-teaser-card">
				<h3>Logo Design</h3>
				<p>A custom logo built around who you are, not a template you found online.</p>
			</div>
			<div class="services-teaser-card">
				<h3>Brand Identity</h3>
				<p>The complete visual system that gives your brand consistency, personality, and something to stand behind, whether you're starting fresh or replacing a look that's run its course.</p>
			</div>
			<div class="services-teaser-card">
				<h3>Elevate the Identity</h3>
				<p>Turn your brand into something people actually want to wear, use, and show off, from merch and swag to the social graphics that carry it everywhere.</p>
			</div>
		</div>
		<Button href="/services">Explore Services</Button>
	</Band>

	<!-- PHILOSOPHY -->
	<Band variant="soft" class="philosophy-band">
		<div class="philosophy-split">
			<div class="philosophy">
				<Eyebrow>Why this work matters</Eyebrow>
				<h2>The best identities aren't designed in a vacuum. They're discovered.</h2>
				<p>When I played rugby, our branding never matched the pride we had for the team. The logo was generic, the merch was forgettable, and I always wished we had something people were actually excited to wear.</p>
				<p>That stuck with me. The identities that last aren't pulled from a template. They come from the people, the place, and the story a business or team already carries.</p>
				<blockquote class="pull-quote">I don't build logos from a template. I build identities that people are proud to represent, wherever they show up.</blockquote>
			</div>
			<div class="philosophy-image">
				<img src="/images/legacy-session/rugby-team.jpg" alt="Nick's club rugby team posing together with their trophy and medals after a tournament win" loading="lazy" />
			</div>
		</div>
	</Band>

	<!-- PROCESS -->
	<Band variant="dark" class="process-band">
		<svg slot="decoration" class="stripe-mark" style="top: 20px; left: 20px; width: 200px; height: 200px; opacity: 0.4;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="20" y="30" width="120" height="14" rx="7" fill="var(--accent)" opacity="0.25"/>
				<rect x="40" y="60" width="140" height="14" rx="7" fill="var(--text-on-dark)" opacity="0.1"/>
				<rect x="10" y="90" width="90" height="14" rx="7" fill="var(--accent)" opacity="0.15"/>
			</g>
		</svg>
		<Eyebrow>The Next Chapter Method</Eyebrow>
		<h2>Your next chapter starts here.</h2>
		<div class="process-grid process-grid-three">
			<div class="process-card">
				<span class="process-num">01</span>
				<h3>Start with the story</h3>
				<p>We talk about where you've been, where you're going, and what makes you different.</p>
			</div>
			<div class="process-card">
				<span class="process-num">02</span>
				<h3>Build the identity</h3>
				<p>I turn those ideas into a visual identity that looks like you and means something.</p>
			</div>
			<div class="process-card">
				<span class="process-num">03</span>
				<h3>Put it everywhere</h3>
				<p>Your new brand shouldn't live in a folder on your computer. We make sure it works wherever people see it.</p>
			</div>
		</div>
	</Band>

	<!-- SELECTED WORK -->
	<Band variant="cream" class="work-band">
		<div class="work-header">
			<Eyebrow>My Work</Eyebrow>
			<a href="/design" class="arrow-link">
				View all work
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
			</a>
		</div>

		<div class="design-row-two">
			<a href="/design/utah-flag" class="design-img-card">
				<img src="/images/case-studies/utah-flag/card-hero.jpg" alt="Nick's submission for Utah's state flag redesign" />
				<div class="design-img-overlay">
					<div>
						<div class="overlay-name">Utah State Flag</div>
						<div class="overlay-tag">Civic Identity · Competition</div>
					</div>
				</div>
			</a>
			<a href="/design/hey-bright" class="design-img-card">
				<img src="/images/case-studies/hey-bright/card-hero.jpg" alt="Hey Bright brand identity" />
				<div class="design-img-overlay">
					<div>
						<div class="overlay-name">Hey Bright</div>
						<div class="overlay-tag">Brand Identity · Packaging</div>
					</div>
				</div>
			</a>
		</div>

		<div class="design-row">
			<a href="/design/quickfuze" class="design-img-card">
				<img src="/images/case-studies/quickfuze/card-hero.jpg" alt="QuickFuze brand identity" />
				<div class="design-img-overlay">
					<div>
						<div class="overlay-name">QuickFuze</div>
						<div class="overlay-tag">Brand System · Game Design</div>
					</div>
				</div>
			</a>
			<a href="/design/utah-hockey" class="design-img-card">
				<img src="/images/case-studies/utah-hockey/card-hero.jpg" alt="Utah Hockey concept identities" />
				<div class="design-img-overlay">
					<div>
						<div class="overlay-name">Naming Utah's Hockey Team</div>
						<div class="overlay-tag">Sports Identity · Concept</div>
					</div>
				</div>
			</a>
			<a href="/design/nhl-midnight" class="design-img-card">
				<img src="/images/case-studies/nhl-midnight/card-hero.jpg" alt="NHL Midnight Edition dark-mode alternate identities" />
				<div class="design-img-overlay">
					<div>
						<div class="overlay-name">NHL Midnight Edition</div>
						<div class="overlay-tag">Sports Identity · 32 Teams</div>
					</div>
				</div>
			</a>
		</div>
	</Band>

	<!-- CLOSING CTA -->
	<Band variant="soft" class="closing-cta">
		<svg slot="decoration" class="stripe-mark" style="bottom: 20px; left: 20px; width: 220px; height: 220px; opacity: 0.45;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="10" y="40" width="120" height="14" rx="7" fill="var(--accent)" opacity="0.25"/>
				<rect x="30" y="70" width="150" height="14" rx="7" fill="var(--band-text-strong)" opacity="0.08"/>
				<rect x="0" y="100" width="90" height="14" rx="7" fill="var(--accent)" opacity="0.15"/>
			</g>
		</svg>
		<h2>Ready for your next chapter?</h2>
		<p>You don't need to have everything figured out. You just need to know you're ready for something better. Tell me where you're at, and we'll figure out the rest together.</p>
		<Button href="/next-chapter-session">Start Your Next Chapter</Button>
	</Band>

	<!-- LIGHTBOX -->
	<div id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
		<div id="lightbox-backdrop"></div>
		<div id="lightbox-frame">
			<img id="lightbox-img" src="" alt="" />
			<div id="lightbox-caption">
				<div id="lightbox-caption-text">
					<div id="lightbox-caption-name"></div>
					<div id="lightbox-caption-cat"></div>
				</div>
				<a href="/design" id="lightbox-more">
					See all the work
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
		</div>
		<button id="lightbox-close" aria-label="Close">&times;</button>
	</div>

	<script>
		(function () {
			const lb = document.getElementById('lightbox');
			const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
			const lbName = document.getElementById('lightbox-caption-name');
			const lbCat = document.getElementById('lightbox-caption-cat');
			const lbClose = document.getElementById('lightbox-close');
			const lbBackdrop = document.getElementById('lightbox-backdrop');
			if (!lb || !lbImg || !lbName || !lbCat || !lbClose || !lbBackdrop) return;

			function openLB(src: string, alt: string, name: string, cat: string) {
				lbImg!.src = src;
				lbImg!.alt = alt;
				lbName!.textContent = name;
				lbCat!.textContent = cat;
				lb!.classList.add('open');
				lb!.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			function closeLB() {
				lb!.classList.remove('open');
				lb!.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				setTimeout(function () { lbImg!.src = ''; }, 200);
			}

			document.querySelectorAll('.design-row .design-img-card').forEach(function (card) {
				card.addEventListener('click', function (e) {
					e.preventDefault();
					const img = card.querySelector('img') as HTMLImageElement;
					const nameEl = card.querySelector('.overlay-name');
					const catEl = card.querySelector('.overlay-tag');
					openLB(img.src, img.alt, nameEl ? nameEl.textContent ?? '' : '', catEl ? catEl.textContent ?? '' : '');
				});
			});

			lbClose.addEventListener('click', closeLB);
			lbBackdrop.addEventListener('click', closeLB);
			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape') closeLB();
			});
		})();
	</script>
</Layout>

<style>
	/* .eyebrow is defined in global.css (shared pill, every page).
	   --band-text-strong / --band-text-dim are defined in global.css
	   too (Band.astro's cream/soft variants), referenced directly by
	   the stripe-mark SVGs below. */

	/* ═══ DECORATIVE STRIPE MARK ═══ */

	/* overflow: visible since the rotated rects inside can extend a
	   few units past the 200x200 viewBox on some corners — SVGs clip
	   to their viewBox by default, which was cutting a sliver off a
	   rounded end. */
	.stripe-mark { position: absolute; pointer-events: none; z-index: 0; overflow: visible; }

	/* ═══ BAND PADDING ═══
	   Band.astro owns background/color/overflow per variant and the
	   shared .content wrapper; each band's own padding stays here
	   since it's genuinely unique per band and per breakpoint. These
	   classes land on Band's own <section> (passed via its `class`
	   prop), which carries Band's scope id, not this page's — so each
	   needs :global() to match. */

	:global(.hero-section) { padding: 48px 0 72px; }
	:global(.problem-band) { padding: 72px 0; text-align: center; }
	:global(.services-teaser-band) { padding: 80px 0; }
	:global(.philosophy-band) { padding: 80px 0; }
	:global(.process-band) { padding: 80px 0; }
	:global(.work-band) { padding: 80px 0 56px; }
	:global(.closing-cta) { padding: 96px 0; text-align: center; }

	/* ═══ HERO ═══ */

	.hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 48px;
		align-items: center;
	}

	.hero h1 {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: var(--fs-hero);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 0.98;
		color: var(--text-on-dark);
		margin-bottom: 22px;
	}

	.hero h1 .accent-word { color: var(--accent-bright); }

	.hero-subhead {
		font-size: var(--fs-lead);
		font-weight: 400;
		color: var(--text-on-dark-dim);
		line-height: 1.55;
		max-width: 480px;
		margin-bottom: 14px;
	}

	.hero-tagline {
		font-size: var(--fs-small);
		font-weight: 500;
		color: var(--accent-bright);
		line-height: 1.5;
		max-width: 480px;
		margin-bottom: 28px;
	}

	/* inline-flex (not flex) so the container's width shrinks to its
   widest child — the secondary button row — rather than stretching
   to fill the whole hero column. align-items: stretch then makes
   the primary button match that width exactly. */
.hero-actions { display: inline-flex; flex-direction: column; align-items: stretch; gap: 14px; }
.hero-actions-secondary { display: flex; gap: 14px; flex-wrap: wrap; }

	.hero-image {
		max-width: 88%;
		margin: 0 auto;
		border-radius: var(--radius);
		border: 1px solid var(--border-on-dark);
		overflow: hidden;
		background: var(--surface);
	}

	/* height: auto, not a fixed aspect-ratio/cover crop — displays the
	   Get It Write brand board at its true (square) proportions instead
	   of forcing a crop. */
	.hero-image img { width: 100%; height: auto; display: block; }

	/* Matches /design's .featured-card-cat treatment (small uppercase
	   case-study label), swapped to --accent-bright since this sits on
	   the hero's dark band rather than a light card. */
	.hero-image-caption {
		font-size: var(--fs-micro);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-bright);
		margin-top: 10px;
		text-align: center;
	}

	/* ═══ PROBLEM (light rest-stop band) ═══ */

	.problem-line {
		font-size: var(--fs-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.3;
		max-width: 800px;
		margin: 0 auto 16px;
		color: var(--band-text-strong);
	}

	.problem-body p {
		font-size: var(--fs-body-lg);
		font-weight: 400;
		color: var(--band-text-dim);
		line-height: 1.6;
		max-width: 620px;
		margin: 0 auto 12px;
	}

	.problem-sub {
		font-size: var(--fs-body-lg);
		font-weight: 400;
		color: var(--band-text-dim);
		line-height: 1.6;
		max-width: 620px;
		margin: 8px auto 0;
	}

	/* ═══ SERVICES TEASER (dark band) ═══ */

	:global(.services-teaser-band) h2 {
		font-size: var(--fs-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.3;
		max-width: 700px;
		margin-bottom: 16px;
		color: var(--text-on-dark);
	}

	.services-teaser-lead {
		font-size: var(--fs-body-lg);
		color: var(--text-on-dark-dim);
		line-height: 1.6;
		max-width: 640px;
		margin-bottom: 40px;
	}

	.services-teaser-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin-bottom: 40px;
	}

	.services-teaser-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 22px 20px;
	}

	.services-teaser-card h3 {
		font-size: var(--fs-h4);
		font-weight: 700;
		color: var(--text-on-dark);
		margin-bottom: 8px;
	}

	.services-teaser-card p {
		font-size: var(--fs-small);
		color: var(--text-on-dark-dim);
		line-height: 1.55;
	}

	/* ═══ PHILOSOPHY (soft-oat rest-stop band) ═══ */

	.philosophy-split {
		display: grid;
		grid-template-columns: 1fr 0.85fr;
		gap: 48px;
		align-items: start;
	}

	.philosophy { max-width: 600px; }

	.philosophy-image {
		border-radius: var(--radius);
		border: 1px solid var(--border-on-light);
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: var(--surface-card);
	}

	.philosophy-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.philosophy h2 {
		font-size: var(--fs-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.25;
		color: var(--band-text-strong);
		margin-bottom: 26px;
	}

	/* No :not(.eyebrow) exclusion needed: Eyebrow.astro's <p> carries
	   its own component scope id, not this page's, so it already
	   can't match this page-scoped selector. */
	.philosophy p {
		font-size: var(--fs-body-lg);
		font-weight: 400;
		color: var(--band-text-dim);
		line-height: 1.7;
		margin-bottom: 18px;
		max-width: 620px;
	}

	.pull-quote {
		margin-top: 32px;
		padding: 28px 32px;
		border-radius: var(--radius);
		background: var(--accent-dim);
		border-left: 3px solid var(--accent);
		color: var(--band-text-strong);
		font-size: var(--fs-lead);
		font-weight: 600;
		line-height: 1.55;
		letter-spacing: -0.005em;
	}

	/* ═══ PROCESS (dark green band, same as hero) ═══ */

	:global(.process-band) h2 {
		font-size: var(--fs-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 40px;
		max-width: 560px;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.process-grid-three { grid-template-columns: repeat(3, 1fr); }

	.process-card {
		background: var(--surface-cream);
		border: 1px solid var(--border-on-light);
		border-radius: var(--radius);
		padding: 24px 22px;
	}

	.process-num {
		display: block;
		font-family: 'Fira Code', monospace;
		font-size: var(--fs-process-num);
		font-weight: 400;
		color: var(--accent-cool);
		margin-bottom: 16px;
	}

	.process-card h3 {
		font-size: var(--fs-h4);
		font-weight: 700;
		color: var(--band-text-strong);
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.process-card p {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--band-text-dim);
		line-height: 1.55;
	}

	/* ═══ SELECTED WORK (light rest-stop band) ═══ */

	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 20px;
		gap: 16px;
		flex-wrap: wrap;
	}

	/* .eyebrow is authored by Eyebrow.astro, a different component
	   scope, so this needs :global() to match it. */
	.work-header :global(.eyebrow) { margin-bottom: 0; }

	.arrow-link { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-small); font-weight: 600; text-decoration: none; color: var(--band-text-strong); transition: gap 0.25s ease, color 0.25s ease; }
	.arrow-link svg { width: 13px; height: 13px; color: var(--accent); }
	.arrow-link:hover { gap: 10px; color: var(--accent); }

	.design-img-card {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--surface-card);
		display: block;
		text-decoration: none;
	}

	.design-img-card img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.5s ease;
		object-fit: cover;
	}

	.design-img-card:hover img { transform: scale(1.03); }

	.design-img-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--overlay-scrim) 0%, transparent 50%);
		opacity: 0;
		transition: opacity 0.3s ease;
		display: flex;
		align-items: flex-end;
		padding: 14px;
	}

	.design-img-card:hover .design-img-overlay { opacity: 1; }

	.overlay-name { font-size: var(--fs-small); font-weight: 600; color: var(--overlay-text); }
	.overlay-tag { font-size: var(--fs-micro); color: var(--overlay-text-accent); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 2px; }

	.design-row-two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
