	<!-- LIGHTBOX -->
	<div id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
		<div id="lightbox-backdrop"></div>
		<div id="lightbox-frame">
			<img id="lightbox-img" src="" alt="" />
			<div id="lightbox-caption">
				<div id="lightbox-caption-name"></div>
				<div id="lightbox-caption-cat"></div>
			</div>
		</div>
		<button id="lightbox-close" aria-label="Close">&times;</button>
	</div>

	<script>
		(function () {
			const lb = document.getElementById('lightbox');
			const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
			const lbName = document.getElementById('lightbox-caption-name');
			const lbCat = document.getElementById('lightbox-caption-cat');
			const lbClose = document.getElementById('lightbox-close');
			const lbBackdrop = document.getElementById('lightbox-backdrop');
			if (!lb || !lbImg || !lbName || !lbCat || !lbClose || !lbBackdrop) return;

			function openLB(src: string, alt: string, name: string, cat: string) {
				lbImg!.src = src;
				lbImg!.alt = alt;
				lbName!.textContent = name;
				lbCat!.textContent = cat;
				lb!.classList.add('open');
				lb!.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			function closeLB() {
				lb!.classList.remove('open');
				lb!.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				setTimeout(function () { lbImg!.src = ''; }, 200);
			}

			document.querySelectorAll('.gallery-tile').forEach(function (tile) {
				tile.addEventListener('click', function (e) {
					e.preventDefault();
					const img = tile.querySelector('img') as HTMLImageElement;
					const nameEl = tile.querySelector('.gallery-tile-name');
					const catEl = tile.querySelector('.gallery-tile-cat');
					openLB(img.src, img.alt, nameEl ? nameEl.textContent ?? '' : '', catEl ? catEl.textContent ?? '' : '');
				});
			});

			lbClose.addEventListener('click', closeLB);
			lbBackdrop.addEventListener('click', closeLB);
			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape') closeLB();
			});
		})();
	</script>
</Layout>

<style>
	.content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 48px;
	}

	/* ═══ HEADER (tightened) ═══ */

	.page-header {
		padding: 48px 0 32px;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.header-left {
		max-width: 540px;
	}

	/* .eyebrow is defined in global.css (shared pill, every page). */

	.page-header h1 {
		font-size: var(--fs-h1);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--text-strong);
		margin-bottom: 14px;
	}

	.header-tagline {
		font-size: var(--fs-body);
		color: var(--text-dim);
		line-height: 1.6;
		max-width: 480px;
		margin-bottom: 14px;
	}

	/* Availability indicator */
	.availability-bar {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: var(--fs-caption);
		font-weight: 500;
		color: var(--accent);
		letter-spacing: 0.02em;
	}

	.availability-bar::before {
		content: '';
		width: 7px; height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent); }
		50% { opacity: 0.6; box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 80%, transparent); }
	}

	.header-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		flex-shrink: 0;
		padding-bottom: 4px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 15px 28px;
		border-radius: 100px;
		font-size: var(--fs-small);
		font-weight: 700;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-primary { background: var(--accent); color: var(--btn-primary-text); }
	.btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.25); }

	.btn-secondary {
		background: transparent;
		color: var(--text-on-dark);
		border: 1.5px solid var(--border-on-dark);
		font-weight: 600;
	}
	.btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

	.divider {
		border-bottom: 1px solid var(--border);
		margin-bottom: 48px;
	}

	/* ═══ BANDS ═══
	   Full-bleed alternating sections, matching the homepage's banding.
	   Scoped custom-property overrides mean every existing rule below
	   (which already references these tokens) resolves to light-band-
	   appropriate colors without needing its own edit. */

	.design-band-light {
		background: var(--surface-cream);
		padding: 64px 0;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}

	.design-band-dark { padding: 64px 0; }

	.design-band-soft {
		background: var(--surface-soft);
		padding: 64px 0;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}

	/* ═══ FEATURED PROJECTS ═══ */

	.featured-section {
		margin-bottom: 0;
	}

	.featured-label {
		margin-bottom: 24px;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.featured-card {
		display: block;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.3s ease;
		position: relative;
	}

	.featured-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 80% 20%, var(--accent-warm-dim), transparent 60%);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
		z-index: 1;
	}

	.featured-card:hover::before { opacity: 1; }
	.featured-card:hover {
		border-color: color-mix(in srgb, var(--accent-warm) 18%, transparent);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(0,0,0,0.3);
	}

	.featured-card-image {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--surface-raised);
	}

	.featured-card-image img {
		width: 100%; height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.featured-card:hover .featured-card-image img { transform: scale(1.04); }

	.featured-card-image .badge {
		position: absolute;
		top: 14px; left: 14px;
		z-index: 2;
		font-size: var(--fs-micro);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 5px 10px;
		border-radius: 100px;
		background: rgba(17, 17, 16, 0.85);
		color: var(--accent-warm);
		border: 1px solid rgba(184, 137, 106, 0.3);
		backdrop-filter: blur(8px);
	}

	/* Sage-colored badge for recognition signals */
	.featured-card-image .badge.badge-sage {
		color: var(--accent);
