---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
---

<Layout
	title="Sports Identity Design — IslandTwig Studios"
	description="Sports identity design by Nick Holmquist. Logos, uniform designs, and merch designs for teams with a story, built from research, not templates."
	path="/sports"
>
	<div class="content">

		<!-- HEADER -->
		<header class="page-header">
			<div class="header-left">
				<p class="eyebrow">Sports</p>
				<h1>Sports identity design.</h1>
				<p class="header-tagline">Logos, uniform designs, and merch designs for teams with a story. Built from the people, place, and traditions your team already carries.</p>
				<div class="availability-bar">Available for new projects</div>
			</div>
			<div class="header-right">
				<a href="/services" class="btn btn-secondary">See services</a>
			</div>
		</header>
	</div>

	<section class="design-band-light">
	<div class="content">
		<!-- FEATURED: UTAH HOCKEY + NHL MIDNIGHT -->
		<section class="featured-section">
			<div class="eyebrow featured-label">Featured Work</div>

			<div class="featured-grid">

				<a href="/design/utah-hockey" class="featured-card">
					<div class="featured-card-image">
						<span class="badge">Case Study</span>
						<img src="/images/case-studies/utah-hockey/card-hero.jpg" alt="Utah hockey concept identities" />
					</div>
					<div class="featured-card-body">
						<div class="featured-card-cat">Sports Identity · Hockey · Concept</div>
						<h2>Naming Utah's Hockey Team</h2>
						<p class="featured-card-desc">Nine named directions for the franchise that became the Mammoth. Logo, wordmark, and full jersey kit for each, plus the rejected concepts and what they taught me about scope.</p>
						<span class="featured-card-link">
							View case study
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</span>
					</div>
				</a>

				<a href="/design/nhl-midnight" class="featured-card">
					<div class="featured-card-image">
						<span class="badge">Case Study</span>
						<img src="/images/case-studies/nhl-midnight/card-hero.jpg" alt="NHL Midnight Edition dark-mode alternate identities" />
					</div>
					<div class="featured-card-body">
						<div class="featured-card-cat">Sports Identity · Concept · Scope Study</div>
						<h2>NHL Midnight Edition</h2>
						<p class="featured-card-desc">Dark-mode alternate identities for all 32 NHL teams. One concept, thirty-two distinct expressions, organized by division. A study in how much a brand system bends without breaking.</p>
						<span class="featured-card-link">
							View case study
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</span>
					</div>
				</a>

			</div>
		</section>
	</div>
	</section>

	<section class="design-band-dark">
	<div class="content">
		<!-- MORE SPORTS WORK GALLERY -->
		<section class="gallery-section">
			<div class="eyebrow gallery-label">More Sports Work</div>
			<p class="gallery-desc">Competition entries, concept explorations, and spec work across hockey, basketball, baseball, and football. Winners and top finishes noted.</p>

			<div class="gallery-grid">

				<a href="#" class="gallery-tile">
					<img src="/images/gallery/roadrunners.jpg" alt="Utah Roadrunners concept" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Utah Roadrunners</div>
							<div class="gallery-tile-cat">Sports Identity · Hockey</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<img src="/images/gallery/florida-alliance.jpg" alt="Florida Alliance jerseys" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Florida Alliance</div>
							<div class="gallery-tile-cat">Jersey Design · Hockey</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<span class="gallery-tile-badge">Winner</span>
					<img src="/images/gallery/magic-city-edition.jpg" alt="Orlando Magic City Edition concept" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Orlando Magic City Edition</div>
							<div class="gallery-tile-cat">Sports Identity · Basketball</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<span class="gallery-tile-badge">Top 8</span>
					<img src="/images/gallery/rainbow-warriors.jpg" alt="Hawaii Rainbow Warriors concept" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Hawaii Rainbow Warriors</div>
							<div class="gallery-tile-cat">Sports Identity · Basketball</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<img src="/images/gallery/tsu-armadillos.jpg" alt="TSU Armadillos concept" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">TSU Armadillos</div>
							<div class="gallery-tile-cat">Sports Identity · Collegiate</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile" data-full="/images/gallery/BoltsUpdated_2.jpg" data-full-alt="Utah Bolts jersey concepts">
					<img src="/images/gallery/BoltsUpdated_1.jpg" alt="Utah Bolts MLB concept updated" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Utah Bolts</div>
							<div class="gallery-tile-cat">Sports Identity · Baseball</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<img src="/images/gallery/jazz-city-edition.jpg" alt="Utah Jazz City Edition concept" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Utah Jazz City Edition</div>
							<div class="gallery-tile-cat">Sports Identity · Basketball</div>
						</div>
					</div>
				</a>

				<a href="#" class="gallery-tile">
					<img src="/images/gallery/ogden-raptors.png" alt="Ogden Raptors logo redesign, before and after" />
					<div class="gallery-tile-overlay">
						<div>
							<div class="gallery-tile-name">Ogden Raptors</div>
							<div class="gallery-tile-cat">Sports Identity · Logo Redesign</div>
						</div>
					</div>
				</a>

			</div>
		</section>
	</div>
	</section>

	<section class="design-band-soft">
	<div class="content">
		<!-- WHAT TEAMS GET -->
		<section class="teams-get-section">
			<div class="eyebrow">What Teams Get</div>
			<h2 class="teams-get-heading">A complete identity built to represent your team.</h2>
			<div class="teams-get-grid">
				<div class="teams-get-card">
					<h3>Primary Logo</h3>
					<p>The main mark your team is known by.</p>
				</div>
				<div class="teams-get-card">
					<h3>Alternate Marks</h3>
					<p>Secondary logos, wordmarks, and badges for every use.</p>
				</div>
				<div class="teams-get-card">
					<h3>Uniform Designs</h3>
					<p>Home, away, and alternate uniform concepts, ready to hand to your manufacturer.</p>
				</div>
				<div class="teams-get-card">
					<h3>Merch Designs</h3>
					<p>Print-ready artwork for hats, shirts, and hoodies, ready to send to your printer.</p>
				</div>
			</div>
		</section>
	</div>
	</section>

	<!-- CLOSING CTA (same block used at the bottom of the homepage) -->
	<Band variant="soft" class="closing-cta">
		<svg slot="decoration" class="stripe-mark" style="bottom: 20px; left: 20px; width: 220px; height: 220px; opacity: 0.45;" viewBox="0 0 200 200">
			<g transform="rotate(-22 100 100)">
				<rect x="10" y="40" width="120" height="14" rx="7" fill="var(--accent)" opacity="0.25"/>
				<rect x="30" y="70" width="150" height="14" rx="7" fill="var(--band-text-strong)" opacity="0.08"/>
				<rect x="0" y="100" width="90" height="14" rx="7" fill="var(--accent)" opacity="0.15"/>
			</g>
		</svg>
		<h2>Ready for your next chapter?</h2>
		<p>You don't need to have everything figured out. You just need to know you're ready for something better. Tell me where you're at, and we'll figure out the rest together.</p>
		<Button href="/next-chapter-session">Start Your Next Chapter</Button>
	</Band>

	<!-- LIGHTBOX -->
	<div id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
		<div id="lightbox-backdrop"></div>
		<div id="lightbox-frame">
			<img id="lightbox-img" src="" alt="" />
			<div id="lightbox-caption">
				<div id="lightbox-caption-name"></div>
				<div id="lightbox-caption-cat"></div>
			</div>
		</div>
		<button id="lightbox-close" aria-label="Close">&times;</button>
	</div>

	<script>
		(function () {
			const lb = document.getElementById('lightbox');
			const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
			const lbName = document.getElementById('lightbox-caption-name');
			const lbCat = document.getElementById('lightbox-caption-cat');
			const lbClose = document.getElementById('lightbox-close');
			const lbBackdrop = document.getElementById('lightbox-backdrop');
			if (!lb || !lbImg || !lbName || !lbCat || !lbClose || !lbBackdrop) return;

			function openLB(src: string, alt: string, name: string, cat: string) {
				lbImg!.src = src;
				lbImg!.alt = alt;
				lbName!.textContent = name;
				lbCat!.textContent = cat;
				lb!.classList.add('open');
				lb!.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			function closeLB() {
				lb!.classList.remove('open');
				lb!.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				setTimeout(function () { lbImg!.src = ''; }, 200);
			}

			document.querySelectorAll('.gallery-tile').forEach(function (tile) {
				tile.addEventListener('click', function (e) {
					e.preventDefault();
					const img = tile.querySelector('img') as HTMLImageElement;
					const nameEl = tile.querySelector('.gallery-tile-name');
					const catEl = tile.querySelector('.gallery-tile-cat');
					const el = tile as HTMLElement;
					const fullSrc = el.dataset.full || img.src;
					const fullAlt = el.dataset.fullAlt || img.alt;
					openLB(fullSrc, fullAlt, nameEl ? nameEl.textContent ?? '' : '', catEl ? catEl.textContent ?? '' : '');
				});
			});

			lbClose.addEventListener('click', closeLB);
			lbBackdrop.addEventListener('click', closeLB);
			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape') closeLB();
			});
		})();
	</script>
</Layout>

<style>
	.content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 48px;
	}

	/* ═══ HEADER (tightened) ═══ */

	.page-header {
		padding: 48px 0 32px;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.header-left {
		max-width: 540px;
	}

	/* .eyebrow is defined in global.css (shared pill, every page). */

	.page-header h1 {
		font-size: var(--fs-h1);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--text-strong);
		margin-bottom: 14px;
	}

	.header-tagline {
		font-size: var(--fs-body);
		color: var(--text-dim);
		line-height: 1.6;
		max-width: 480px;
		margin-bottom: 14px;
	}

	/* Availability indicator. Uses --accent-bright, not --accent — sits
	   directly on the dark ink header, and the base purple is too dark
	   to read there. */
	.availability-bar {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: var(--fs-caption);
		font-weight: 500;
		color: var(--accent-bright);
		letter-spacing: 0.02em;
	}

	.availability-bar::before {
		content: '';
		width: 7px; height: 7px;
		border-radius: 50%;
		background: var(--accent-bright);
		box-shadow: 0 0 8px color-mix(in srgb, var(--accent-bright) 60%, transparent);
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent); }
		50% { opacity: 0.6; box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 80%, transparent); }
	}

	.header-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		flex-shrink: 0;
		padding-bottom: 4px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 15px 28px;
		border-radius: 100px;
		font-size: var(--fs-small);
		font-weight: 700;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-primary { background: var(--accent); color: var(--btn-primary-text); }
	.btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.25); }

	.btn-secondary {
		background: transparent;
		color: var(--text-on-dark);
		border: 1.5px solid var(--border-on-dark);
		font-weight: 600;
	}
	.btn-secondary:hover { border-color: var(--accent-bright); color: var(--accent-bright); }

	/* ═══ BANDS ═══
	   Full-bleed alternating sections, matching /design's banding. */

	.design-band-light {
		background: var(--surface-cream);
		padding: 64px 0;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}

	.design-band-dark { padding: 64px 0; }

	.design-band-soft {
		background: var(--surface-soft);
		padding: 64px 0;
		--text-strong: #1a1c1a;
		--text: #1a1c1a;
		--text-dim: #5a5f5a;
		--text-faint: rgba(42, 46, 40, 0.05);
		--border: var(--border-on-light);
		--surface: var(--surface-card);
		--surface-raised: #ffffff;
	}

	/* ═══ FEATURED PROJECTS ═══ */

	.featured-section {
		margin-bottom: 0;
	}

	.featured-label {
		margin-bottom: 24px;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.featured-card {
		display: block;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.3s ease;
		position: relative;
	}

	.featured-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 80% 20%, var(--accent-warm-dim), transparent 60%);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
		z-index: 1;
	}

	.featured-card:hover::before { opacity: 1; }
	.featured-card:hover {
		border-color: color-mix(in srgb, var(--accent-warm) 18%, transparent);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(0,0,0,0.3);
	}

	.featured-card-image {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--surface-raised);
	}

	.featured-card-image img {
		width: 100%; height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.featured-card:hover .featured-card-image img { transform: scale(1.04); }

	.featured-card-image .badge {
		position: absolute;
		top: 14px; left: 14px;
		z-index: 2;
		font-size: var(--fs-micro);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 5px 10px;
		border-radius: 100px;
		background: var(--accent-bright);
		color: #1a1c1a;
	}

	.featured-card-body {
		padding: 22px 24px 24px;
		position: relative;
		z-index: 2;
	}

	.featured-card-cat {
		font-size: var(--fs-micro);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-warm);
		margin-bottom: 6px;
	}

	.featured-card h2 {
		font-size: var(--fs-h3);
		font-weight: 700;
		color: var(--text-strong);
		letter-spacing: -0.01em;
		line-height: 1.2;
		margin-bottom: 8px;
	}

	.featured-card-desc {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.55;
		margin-bottom: 14px;
	}

	.featured-card-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--accent-warm);
		transition: gap 0.25s ease;
	}
	.featured-card:hover .featured-card-link { gap: 10px; }
	.featured-card-link svg { width: 13px; height: 13px; }

	/* ═══ GALLERY SECTIONS ═══ */

	.gallery-section {
		margin-bottom: 0;
	}

	.gallery-label {
		margin-bottom: 10px;
	}

	.gallery-desc {
		font-size: var(--fs-small);
		font-weight: 400;
		color: var(--text-dim);
		line-height: 1.6;
		max-width: 560px;
		margin-bottom: 24px;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
	}

	.gallery-tile-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		z-index: 2;
		font-size: var(--fs-micro);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 4px 9px;
		border-radius: 100px;
		background: var(--accent-bright);
		color: #1a1c1a;
		pointer-events: none;
	}

	.gallery-tile {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--surface);
		aspect-ratio: 4 / 5;
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.gallery-tile img {
		width: 100%; height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.gallery-tile:hover img { transform: scale(1.04); }

	.gallery-tile-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(17,17,16,0.92) 0%, rgba(17,17,16,0.3) 50%, transparent 80%);
		display: flex;
		align-items: flex-end;
		padding: 16px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.gallery-tile:hover .gallery-tile-overlay { opacity: 1; }

	.gallery-tile-name {
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--text);
	}

	.gallery-tile-cat {
		font-size: var(--fs-micro);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-bright);
		margin-top: 3px;
	}

	/* ═══ WHAT TEAMS GET ═══ */

	.teams-get-section :global(.eyebrow) { margin-bottom: 16px; }

	.teams-get-heading {
		font-size: var(--fs-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.3;
		max-width: 620px;
		margin-bottom: 28px;
		color: var(--text-strong);
	}

	.teams-get-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.teams-get-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 22px 20px;
	}

	.teams-get-card h3 {
		font-size: var(--fs-h4);
		font-weight: 700;
		color: var(--text-strong);
		margin-bottom: 8px;
	}

	.teams-get-card p {
		font-size: var(--fs-small);
		color: var(--text-dim);
		line-height: 1.55;
	}

	/* ═══ CLOSING CTA (matches the homepage's) ═══ */

	/* Astro's scoped styles don't cross files, so this needs its own
	   copy of index.astro's .stripe-mark rule or the decoration svg
	   renders in normal flow and blows out the section height. */
	.stripe-mark { position: absolute; pointer-events: none; z-index: 0; overflow: visible; }

	:global(.closing-cta) { padding: 96px 0; text-align: center; }

	:global(.closing-cta) h2 {
		font-size: var(--fs-h1);
		font-weight: 800;
		letter-spacing: -0.015em;
		max-width: 680px;
		margin: 0 auto 14px;
		line-height: 1.25;
	}

	:global(.closing-cta) p {
		font-size: var(--fs-body-lg);
		font-weight: 400;
		color: var(--band-text-dim);
		margin-bottom: 30px;
	}

	@media (max-width: 900px) {
		.page-header { flex-direction: column; align-items: flex-start; gap: 20px; }
		.header-right { align-items: flex-start; }
		.featured-grid { grid-template-columns: 1fr; }
		.gallery-grid { grid-template-columns: repeat(3, 1fr); }
		.teams-get-grid { grid-template-columns: 1fr 1fr; }
	}

	@media (max-width: 768px) {
		.content { padding: 0 24px; }
		.gallery-grid { grid-template-columns: repeat(2, 1fr); }
		:global(.closing-cta) { padding: 72px 0; }
	}

	@media (max-width: 480px) {
		.content { padding: 0 20px; }
		.gallery-grid { grid-template-columns: 1fr; }
		.teams-get-grid { grid-template-columns: 1fr; }
	}

	/* ═══ LIGHTBOX ═══ */
	#lightbox {
